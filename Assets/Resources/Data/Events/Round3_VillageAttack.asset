  eventId: village_attack
  roundNumber: 3
  isFinalEvent: 0
  title: "An Attack Threatens the Village"
  description: "An armed group attacked a Mondna village during the night. Homes were set ablaze, and the villagers are seeking shelter. You can combine measures as long as you have the resources: evacuate the families, defend the village, and, if your Diplomacy allows, negotiate safe passage."
  stages:
  - stageId: actions
    title: "Village Actions"
    selectionMode: 1
    minimumSelections: 1
    manualCompletion: 1
  choices:
  - choiceId: evacuate_villagers
    stageId: actions
    buttonLabel: "Evacuate villagers to the castle (2 Supplies, 1 Troop)"
    resultText: "Evacuation organized. Reputation +2, Mother +1; Supplies −2 and Troops −1."
    conditions:
    - conditionType: 1
      attribute: 0
      resource: 2
      relationshipTarget: 0
      minimumValue: 2
      failureMessage: "You need 2 Supplies to organize the evacuation."
    - conditionType: 1
      attribute: 0
      resource: 4
      relationshipTarget: 0
      minimumValue: 1
      failureMessage: "You need 1 Troop to organize the evacuation."
    effects:
    - effectType: 0
      resource: 2
      relationshipTarget: 0
      amount: -2
    - effectType: 0
      resource: 4
      relationshipTarget: 0
      amount: -1
    - effectType: 0
      resource: 3
      relationshipTarget: 0
      amount: 2
    - effectType: 1
      resource: 0
      relationshipTarget: 2
      amount: 1
  - choiceId: defend_village
    stageId: actions
    buttonLabel: "Send the militia to defend the village (2 Troops, 1 Treasury)"
    resultText: "Village defended. Reputation +1, General +1, and Crown +1; Troops −2 and Treasury −1."
    conditions:
    - conditionType: 1
      attribute: 0
      resource: 4
      relationshipTarget: 0
      minimumValue: 2
      failureMessage: "You need 2 Troops to deploy the militia."
    - conditionType: 1
      attribute: 0
      resource: 1
      relationshipTarget: 0
      minimumValue: 1
      failureMessage: "You need 1 Treasury to deploy the militia."
    effects:
    - effectType: 0
      resource: 4
