  title: "A Noble Refugee Arrives in Mondna"
  description: "A noble refugee arrives in Mondna lands. Loyal to the Crown, he says he escaped a city taken by the rebels. He carries sealed documents and asks for shelter until he can reach the royal army. His presence may protect your family, but could also make Mondna lands a target."
  stages:
  - stageId: decision
    title: "Decide the Refugee's Fate"
    selectionMode: 0
    minimumSelections: 1
    manualCompletion: 0
  choices:
  - choiceId: grant_shelter
    stageId: decision
    buttonLabel: "Grant shelter in the castle (1 Supply)"
    resultText: "Shelter granted. Refugee Noble +2, Crown +2, Rebels −1, and Reputation +1; Supplies −1."
    conditions:
    - conditionType: 1
      attribute: 0
      resource: 2
      relationshipTarget: 0
      minimumValue: 1
      failureMessage: "You need 1 Supply to shelter the noble."
