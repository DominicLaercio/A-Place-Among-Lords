  m_Script: {fileID: 11500000, guid: 61a6c5b794a546cb8ec4be3c5afc9401, type: 3}
  m_Name: Round1_Mother
  m_EditorClassIdentifier: 
  dialogueId: round1_mother
  roundNumber: 1
  conversationKey: mother
  speakerName: "Mother"
  openingText: "Your mother urges caution: war could consume what your family has built over generations."
  relationshipTarget: 2
  responses:
  - playerResponse: "Promise to consider her concerns"
    characterReply: "She seems a little calmer, though she still fears for the safety of the Mondna lands."
    relationshipChange: 1
  - playerResponse: "Thank her, but make no commitment"
    characterReply: "She accepts your answer without feeling closer to or more distant from you."
    relationshipChange: 0
  - playerResponse: "Say the risk will not change your decision"
    characterReply: "Your mother realizes that you do not intend to follow her advice."
    relationshipChange: -1