  dialogueId: round3_mother
  roundNumber: 3
  conversationKey: mother
  speakerName: "Mother"
  openingText: "Your mother asks you to evacuate the families before the fire spreads. She fears the village will become another battlefield."
  relationshipTarget: 2
  responses:
  - playerResponse: "Acknowledge your mother's advice"
    characterReply: "Your mother is grateful that you take her concerns seriously."
    relationshipChange: 1
  - playerResponse: "Disagree and follow your own judgment"
    characterReply: "Your mother respects your position, but is hurt by your decision."
    relationshipChange: -1